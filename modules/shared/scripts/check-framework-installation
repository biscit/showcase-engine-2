#!/bin/bash

case $SELECTED_FRAMEWORK in
    laravel)
        if ! command -v laravel &> /dev/null; then
            # Check composer bin
            COMPOSER_BIN=$(composer global config bin-dir --absolute 2>/dev/null)
            if [ ! -f "$COMPOSER_BIN/laravel" ]; then
                error "Laravel installer is missing."
                return 1
            fi
        fi
        ;;

    symfony)
        gum style --foreground 212 --border normal --padding "0 1" \
            "Symfony Module: Under Construction" "" \
            "The Symfony integration is currently under development in the private repository." \
            "Returning to menu..." >&2
        return 1
        ;;

    drupal)
        gum style --foreground 212 --border normal --padding "0 1" \
            "Drupal Module: Under Construction" "" \
            "The Drupal integration is currently under development in the private repository." \
            "Returning to menu..." >&2
        return 1
        ;;

    *)
esac

return 0
